{
  "name": "sink-ts",
  "version": "1.0.0",
  "description": "TypeScript rewrite of the sink service, bootstrapped with Fastify-CLI.",
  "main": "dist/app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/**/*.test.ts",
    "start": "npm run build && fastify start -l info dist/app.js",
    "dev": "fastify start -w -l info -P -r tsx/cjs src/app.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
